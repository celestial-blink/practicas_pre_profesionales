[Unit]
Description=Practicas peru pro
After=network.target mariadb.service
Wants=network.target

[Service]
Type=simple

User=www-data
Group=www-data

WorkingDirectory=/srv/practicasperupro

EnvironmentFile=/srv/practicasperupro/.env

ExecStart=/srv/practicasperupro/bin/rs-backend

Restart=always
RestartSec=5

# Seguridad
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Logs
StandardOutput=journal
StandardError=journal

# maximo de logs y comprimido
JournalMaxUse=100M
JournalCompress=yes

# Limites
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
